# Ariadne 配置模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）

# ========== 数据库 ==========
DATABASE_URL=postgresql://postgres:password@localhost:5432/ariadne
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=ariadne

# ========== 认证 ==========
# JWT 签名密钥（生产环境必须替换为随机强密钥）
JWT_SECRET_KEY=your-secret-key-here-replace-in-production

# ========== LLM Provider（可选）==========
# 如需运行 tests/test_llm_capability.py 进行真实 LLM 能力验收，取消注释并填入真实 key

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT-4
# OPENAI_API_KEY=sk-...

# ========== 能力验收配置（可选）==========
# 成本控制（默认 $100）
# LLM_EVAL_BUDGET_USD=100

# 启用标志（防止 CI 意外运行，成本敏感）
# RUN_LLM_CAPABILITY_TESTS=1

# ========== 其他配置 ==========
# 日志级别
LOG_LEVEL=INFO

# API 服务端口
API_PORT=8000
